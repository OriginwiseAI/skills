{
  "id": "kpainter-openclaw",
  "name": "KPainter OpenClaw",
  "description": "Create explainer videos, AI images, and AI apps through KPainter OpenAPI.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiBaseUrl": { "type": "string", "default": "https://api.kpainter.ai/openapi/v1", "description": "KPainter OpenAPI base URL." },
      "apiKey": { "type": "string", "description": "User API key from https://kpainter.ai/api-key." },
      "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000, "default": 30000, "description": "Request timeout in milliseconds." }
    }
  },
  "contracts": {
    "tools": [
      "kpainter_capabilities",
      "kpainter_upload_file",
      "kpainter_create",
      "kpainter_list",
      "kpainter_get",
      "kpainter_message",
      "kpainter_act",
      "kpainter_outputs"
    ]
  }
}
